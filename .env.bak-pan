# 本地开发环境配置 (Windows)
ENVIRONMENT=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=12345678
MYSQL_DATABASE=xianyu_data
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CORS_ORIGINS=*
BACKEND_WEB_PORT=8089
WEBSOCKET_PORT=8090
SCHEDULER_PORT=8091
WEBSOCKET_SERVICE_URL=http://127.0.0.1:8090
SCHEDULER_SERVICE_URL=http://127.0.0.1:8091
BACKEND_WEB_SERVICE_URL=http://127.0.0.1:8089
STATIC_DIR=D:/xianyu/xianyu-auto-reply/backend-web/static
BACKUP_DIR=D:/xianyu/xianyu-auto-reply/backups
TZ=Asia/Shanghai
BROWSER_HEADLESS=false
HOST=0.0.0.0

# Windows 没有可用的夸克 CLI，留空则资料池「上传网盘」不可用，其余功能不受影响
KUAKE_BIN=
KUAKE_WORKDIR=
KUAKE_ROOT_DIR=/资料池
KUAKE_SHARE_DAYS=30
